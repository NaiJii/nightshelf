{
  "cli": {"version": ">= 24.0.0", "appVersionSource": "local"},
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":background-downloads:testReleaseUnitTest :app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "preview-arm32": {
      "extends": "preview",
      "android": {
        "gradleCommand": ":background-downloads:testReleaseUnitTest :app:assembleRelease -PreactNativeArchitectures=armeabi-v7a"
      }
    },
    "production": {
      "android": {"buildType": "app-bundle"}
    }
  }
}
