{
  "expo": {
    "name": "NightShelf",
    "slug": "nightshelf",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "scheme": "nightshelf",
    "android": {
      "package": "com.ji.nightshelf",
      "versionCode": 19,
      "permissions": [
        "android.permission.INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-background-task",
      "./plugins/with-reader-controls",
      "./plugins/with-release-signing",
      [
        "expo-notifications",
        {
          "color": "#b89bff",
          "defaultChannel": "bookmarked-releases"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "049eb071-c76b-4797-b7e7-03e590619f2b"
      }
    },
    "owner": "naiji"
  }
}
